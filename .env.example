# Copy to .env and fill in what you need. Everything is optional.

# Where password-reset links point. Empty: the address the request came in on.
APP_BASE_URL=http://127.0.0.1:8000

# SQLite file by default.
# DATABASE_URL=sqlite+aiosqlite:///./mood_recipes.db

# Without SMTP_HOST, reset emails are printed in the server console instead.
# Gmail example: smtp.gmail.com, port 587, an app password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mood Recipes <you@example.com>
# Set to true for implicit TLS (usually port 465); otherwise STARTTLS is used.
SMTP_SSL=false
